Bootstrap: docker
From: condaforge/mambaforge:latest

%labels
    Maintainer LaBiOmics/UMC Team <fabianomenegidio@umc.br>
    Version 1.1.0
    Description HumaninFinder: Evolutionary discovery tool (Conda-based Container).

%files
    environment.yml /opt/environment.yml
    . /app

%post
    cd /app
    # Update base environment using the official YAML
    mamba env update -n base -f /opt/environment.yml
    mamba install -y hmmer -c bioconda
    pip install .
    # Bake models
    python -c "from transformers import AutoTokenizer, EsmModel; AutoTokenizer.from_pretrained('facebook/esm2_t6_8M_UR50D'); EsmModel.from_pretrained('facebook/esm2_t6_8M_UR50D')"
    humanin-finder setup

%runscript
    exec humanin-finder "$@"

%help
    HumaninFinder: Evolutionary discovery tool for Humanin-like peptides.
    This container uses the official environment.yml for reproducibility.
    Usage: singularity run humaninfinder.sif [options]
