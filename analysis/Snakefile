# ==============================================================================
# Snakemake Workflow: Humanin Discovery in 343 Primate Mitogenomes
# ==============================================================================

rule all:
    input:
        "results/primates_343_standard_results.csv",
        "results/primates_343_standard_results.fasta",
        "reports/standard/summary_by_clade.csv",
        "reports/standard/summary_metrics.json",
        "reports/standard/primate_analysis_summary.md"

rule predict_standard:
    input:
        fasta="primates_343.fasta"
    output:
        csv="results/primates_343_standard_results.csv",
        fasta="results/primates_343_standard_results.fasta"
    threads: 4
    params:
        prefix="results/primates_343_standard",
        threshold=0.7,
        table=2
    shell:
        """
        python -m humaninfinder.cli predict \
            --input {input.fasta} \
            --output {params.prefix} \
            --table {params.table} \
            --threshold {params.threshold} \
            --hmm \
            --rescue \
            --cpus {threads}
        """

rule summarize_standard:
    input:
        results="results/primates_343_standard_results.csv",
        metadata="primates_343_metadata.tsv"
    output:
        csv="reports/standard/summary_by_clade.csv",
        json="reports/standard/summary_metrics.json",
        report="reports/standard/primate_analysis_summary.md"
    shell:
        """
        python scripts/summarize_primates.py \
            --results {input.results} \
            --metadata {input.metadata} \
            --output-dir reports/standard
        """
